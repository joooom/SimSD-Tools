# ==============================================================================
# SimSD Tools - Configuração de Ambiente
# ==============================================================================

# Configuração de rede interna do backend
HOST=0.0.0.0
PORT=4174
NODE_ENV=production

# ==============================================================================
# OAuth 2.0 - Portal SimSD (https://simsd.sdomingos.com.br)
# ==============================================================================
# Obtenha o Client ID e Client Secret no painel de administração do SimSD.
# O Redirect URI DEVE ser exatamente: https://simsd.treco.space/auth/callback
SIMSD_OAUTH_CLIENT_ID=
SIMSD_OAUTH_CLIENT_SECRET=
SIMSD_OAUTH_REDIRECT_URI=https://simsd.treco.space/auth/callback
SIMSD_OAUTH_BASE_URL=https://simsd.sdomingos.com.br

# ==============================================================================
# Segurança e Autenticação
# ==============================================================================
# Mantenha SIMSD_COOKIE_SECURE=1 para garantir cookies com flag 'Secure' em HTTPS
SIMSD_COOKIE_SECURE=1

# Ative (1) APENAS para testes em desenvolvimento local sem OAuth (0 em produção)
SIMSD_DEV_AUTH=0

# Caminho do banco de dados SQLite persistente (armazenado no volume simsd-data)
SIMSD_DATABASE_PATH=/app/data/simsd.sqlite
