HOST=127.0.0.1
PORT=4174
NODE_ENV=production

# Credenciais geradas no painel SimSD Tools.
SIMSD_OAUTH_CLIENT_ID=
SIMSD_OAUTH_CLIENT_SECRET=
SIMSD_OAUTH_REDIRECT_URI=https://seu-dominio.example/auth/callback
SIMSD_OAUTH_BASE_URL=https://simsd.sdomingos.com.br

# Ative somente em desenvolvimento/testes locais.
SIMSD_DEV_AUTH=0
SIMSD_COOKIE_SECURE=1
SIMSD_DATABASE_PATH=data/simsd.sqlite
